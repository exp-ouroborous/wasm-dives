<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!--
    Roslyn hosted on .NET WebAssembly: compiles visitor code against the full
    .NET 10 reference assemblies and runs it in-process. Built by
    scripts/dotnet.mjs (npm run build) into dist/run/vendor/csharp-runner/.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- User code may call any framework API, so ship the library untrimmed. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Cloudflare compresses on the fly; skip the .br/.gz copies. -->
    <CompressionEnabled>false</CompressionEnabled>
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <!-- Keep the git commit out of the build so the runtime hash (its URL) only changes with the runtime. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <!-- Real exception messages for visitors, not resource keys. -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Basic.Reference.Assemblies.Net100" Version="1.8.13" />
  </ItemGroup>
</Project>
