[
  {
    "name": "sorted, indent 2",
    "input": {
      "action": "format",
      "source": "{\"b\":1,\"a\":{\"d\":[1,2],\"c\":\"x\"}}",
      "indent": 2,
      "sort_keys": true,
      "minify": false,
      "allow_jsonc": false
    },
    "expect": {
      "output": "{\n  \"a\": {\n    \"c\": \"x\",\n    \"d\": [\n      1,\n      2\n    ]\n  },\n  \"b\": 1\n}"
    }
  },
  {
    "name": "input key order is kept without sorting",
    "input": {
      "action": "format",
      "source": "{\"b\":1,\"a\":2}",
      "indent": 2,
      "sort_keys": false,
      "minify": false,
      "allow_jsonc": false
    },
    "expect": {
      "output": "{\n  \"b\": 1,\n  \"a\": 2\n}"
    }
  },
  {
    "name": "indent 4",
    "input": {
      "action": "format",
      "source": "{\"a\":[true]}",
      "indent": 4,
      "sort_keys": false,
      "minify": false,
      "allow_jsonc": false
    },
    "expect": {
      "output": "{\n    \"a\": [\n        true\n    ]\n}"
    }
  },
  {
    "name": "minify",
    "input": {
      "action": "format",
      "source": "{ \"a\" : [ 1 , 2 ] , \"b\" : { } }",
      "indent": 2,
      "sort_keys": false,
      "minify": true,
      "allow_jsonc": false
    },
    "expect": {
      "output": "{\"a\":[1,2],\"b\":{}}"
    }
  },
  {
    "name": "scalars round-trip",
    "input": {
      "action": "format",
      "source": "[true, null, 1.5, -2, \"s\", []]",
      "indent": 2,
      "sort_keys": false,
      "minify": true,
      "allow_jsonc": false
    },
    "expect": {
      "output": "[true,null,1.5,-2,\"s\",[]]"
    }
  },
  {
    "name": "non-ASCII is written raw",
    "input": {
      "action": "format",
      "source": "{\"name\":\"café 😀\",\"q\":\"say \\\"hi\\\"\\n\"}",
      "indent": 2,
      "sort_keys": false,
      "minify": true,
      "allow_jsonc": false
    },
    "expect": {
      "output": "{\"name\":\"café 😀\",\"q\":\"say \\\"hi\\\"\\n\"}"
    }
  },
  {
    "name": "a trailing comma is an error without JSONC",
    "input": {
      "action": "format",
      "source": "{\"a\":1,}",
      "indent": 2,
      "sort_keys": false,
      "minify": false,
      "allow_jsonc": false
    },
    "expect_error": {
      "line": 1
    }
  },
  {
    "name": "a missing comma reports its line",
    "input": {
      "action": "format",
      "source": "{\n  \"a\": 1\n  \"b\": 2\n}",
      "indent": 2,
      "sort_keys": false,
      "minify": false,
      "allow_jsonc": false
    },
    "expect_error": {
      "line": 3
    }
  },
  {
    "name": "JSONC comments and trailing commas",
    "input": {
      "action": "format",
      "source": "{\n  // note\n  \"a\": 1, /* inline */\n  \"b\": [1, 2,],\n}",
      "indent": 2,
      "sort_keys": false,
      "minify": true,
      "allow_jsonc": true
    },
    "expect": {
      "output": "{\"a\":1,\"b\":[1,2]}"
    }
  },
  {
    "name": "analyze builds the tree, paths and summary",
    "input": {
      "action": "analyze",
      "source": "{\"users\":[{\"name\":\"Ada\"}],\"weird key\":true}",
      "indent": 2,
      "sort_keys": false,
      "minify": false,
      "allow_jsonc": false
    },
    "expect": {
      "summary": {
        "root_type": "object",
        "total_nodes": 5,
        "max_depth": 4,
        "root_count": 2
      },
      "paths": [
        "$",
        "$.users",
        "$.users[0]",
        "$.users[0].name",
        "$[\"weird key\"]"
      ],
      "node": {
        "path": "$.users[0].name",
        "type": "string",
        "preview": "\"Ada\"",
        "key": "name",
        "count": 0
      },
      "copy": {
        "path": "$.users",
        "copy_value": "[\n  {\n    \"name\": \"Ada\"\n  }\n]"
      }
    }
  },
  {
    "name": "analyze reports errors with a line",
    "input": {
      "action": "analyze",
      "source": "[1,\n2,,]",
      "indent": 2,
      "sort_keys": false,
      "minify": false,
      "allow_jsonc": false
    },
    "expect_error": {
      "line": 2
    }
  },
  {
    "name": "heal repairs in Python and is unsupported elsewhere",
    "input": {
      "action": "heal",
      "source": "{a: 1}",
      "indent": 2,
      "sort_keys": true,
      "minify": false,
      "allow_jsonc": false
    },
    "only": {
      "python": {
        "output": "{\n  \"a\": 1\n}"
      }
    },
    "unsupported_elsewhere": true
  },
  {
    "name": "empty input is an error on line 1",
    "input": {
      "action": "format",
      "source": "",
      "indent": 2,
      "sort_keys": false,
      "minify": false,
      "allow_jsonc": false
    },
    "expect_error": {
      "line": 1
    }
  },
  {
    "name": "data after the top-level value is an error",
    "input": {
      "action": "format",
      "source": "{\"a\": 1}\n{\"b\": 2}",
      "indent": 2,
      "sort_keys": false,
      "minify": false,
      "allow_jsonc": false
    },
    "expect_error": {
      "line": 2
    }
  },
  {
    "name": "a lone surrogate escape becomes U+FFFD",
    "input": {
      "action": "format",
      "source": "[\"\\ud800x\"]",
      "indent": 2,
      "sort_keys": false,
      "minify": true,
      "allow_jsonc": false
    },
    "expect": {
      "output": "[\"�x\"]"
    },
    "only": {
      "python": {}
    }
  }
]
